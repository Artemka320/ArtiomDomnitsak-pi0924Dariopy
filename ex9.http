{
      "predicates": [
        {
          "and": [
            { "equals": { "method": "POST", "path": "/api/temperature" } },
            { "equals": { "headers": { "Content-Type": "application/json" } } },
            { "contains": { "body": "\"value\"" } }
          ]
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 201,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "status": "created",
              "message": "Medição registada com sucesso"
            }
          }
        }
      ]
    }
